# Copy to .env and fill values. Never commit real secrets.

# PostgreSQL connection string (local Docker, Neon, Prisma Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# JWT session signing secret (min 32 random bytes in production)
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: protect POST /api/admin/seed
# SEED_SECRET="optional-ops-secret"

# Optional: Sentry DSN for error tracking (leave empty to disable)
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""

# Optional: public app URL (used in logs/docs only)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
